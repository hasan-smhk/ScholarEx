generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Role {
  STUDENT
  ADMIN
  COUNSELOR
}

enum ReportApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CounselorCertificationStatus {
  NOT_PROVIDED
  PENDING_VERIFICATION
  VERIFIED
}

enum CounselorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CounselorCertificationEnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  password           String
  role               Role     @default(STUDENT)
  hasUsedFreeSession Boolean  @default(false)
  marksPercentage    Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bookings                        Booking[]
  enrollments                     Enrollment[]
  reports                         Report[]
  reportsReviewed                 Report[]     @relation("ReportReviewer")
  counselorProfile                Counselor?   @relation("CounselorAccount")
  counselorCertificationsReviewed Counselor[]  @relation("CounselorCertificationReviewer")
  counselorApplicationsReviewed   Counselor[]  @relation("CounselorApprovalReviewer")

  @@map("User")
}

model Counselor {
  id                         String                       @id @default(cuid())
  userId                     String?                      @unique
  user                       User?                        @relation("CounselorAccount", fields: [userId], references: [id], onDelete: SetNull)
  name                       String
  email                      String
  mobileNumber               String?
  professionalQualifications String?
  specialization             String
  description                String?
  sessionFee                 Float                        @default(500)
  certificationDetails       String?
  certificationStatus        CounselorCertificationStatus @default(NOT_PROVIDED)
  certificationVerifiedAt    DateTime?
  certificationVerifiedById  String?
  certificationVerifiedBy    User?                        @relation("CounselorCertificationReviewer", fields: [certificationVerifiedById], references: [id], onDelete: SetNull)
  approvalStatus             CounselorApprovalStatus      @default(APPROVED)
  approvalReviewNote         String?
  approvalReviewedAt         DateTime?
  approvalReviewedById       String?
  approvalReviewedBy         User?                        @relation("CounselorApprovalReviewer", fields: [approvalReviewedById], references: [id], onDelete: SetNull)
  applicationEmailSentAt     DateTime?
  approvalEmailSentAt        DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  slots                   Slot[]
  experience              CounselorExperience?
  certificationEnrollment CounselorCertificationEnrollment?

  @@map("Counselor")
}

model CounselorExperience {
  id              String    @id @default(cuid())
  counselorId     String    @unique
  counselor       Counselor @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  yearsExperience Int       @default(0)
  details         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("CounselorExperience")
}

model CounselorCertificationEnrollment {
  id          String                                 @id @default(cuid())
  counselorId String                                 @unique
  counselor   Counselor                              @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  status      CounselorCertificationEnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime                               @default(now())
  updatedAt   DateTime                               @updatedAt

  @@map("CounselorCertificationEnrollment")
}

model Slot {
  id          String    @id @default(cuid())
  counselorId String
  counselor   Counselor @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String
  endTime     String
  isBooked    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings Booking[]

  @@unique([counselorId, date, startTime, endTime])
  @@map("Slot")
}

model Booking {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slotId          String
  slot            Slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  isFreeSession   Boolean       @default(false)
  paymentStatus   PaymentStatus @default(PENDING)
  amount          Float         @default(0)
  marksPercentage Float?
  meetingLink     String?

  educationBackground String?
  currentStream       String?
  careerAspiration    String?
  areasOfInterest     String?
  subjectPreferences  String?
  hobbies             String?
  studentName         String?
  studentAge          Int?
  schoolCollege       String?
  fatherName          String?
  fatherAge           Int?
  fatherOcuupation    String?
  fatherEducation     String?
  motherName          String?
  motherAge           Int?
  motherOcuupation    String?
  motherEducation     String?
  AnnualfamilyIncome  Int?
  familyType          String?
  address             String?
  phoneNo             String?
  emailId             String?
  subjectAssessments  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report Report?

  @@map("Booking")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  board       String // CBSE, ICSE, STATE
  level       String
  instructor  String
  description String?
  price       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]

  @@map("Course")
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    Float     @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())

  @@unique([studentId, courseId])
  @@map("Enrollment")
}

model Report {
  id                 String               @id @default(cuid())
  bookingId          String               @unique
  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId          String
  student            User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvalStatus     ReportApprovalStatus @default(PENDING_REVIEW)
  isAiGenerated      Boolean              @default(false)
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?                @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote         String?
  emailSentAt        DateTime?
  strengths          String?
  areasOfImprovement String?
  recommendations    String?
  nextSteps          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("Report")
}
